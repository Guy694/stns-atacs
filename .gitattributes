# Scripts that run on Linux (agent installers, Docker helpers) must keep LF line endings,
# otherwise `curl ... | bash` fails with "$'\r': command not found".
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker/** text eol=lf
.github/** text eol=lf
# Windows agent scripts
*.ps1 text eol=crlf
