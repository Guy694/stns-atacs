# ── ATACS on Docker: copy to .env.docker (never commit the real file) ──
# Values can be copied from the Vercel project (Settings → Environment Variables); change the URLs.

# Public address
# used in Agent install commands (baked in at build time)
APP_URL=https://atacs.example.go.th
# Caddy: a domain → automatic HTTPS; ":80" → plain HTTP
SITE_ADDRESS=atacs.example.go.th
HTTP_PORT=80
HTTPS_PORT=443
# Only for plain HTTP inside the network (SITE_ADDRESS=:80). Leave unset when using HTTPS.
# AUTH_COOKIE_SECURE=false

# Database (the "db" container; the app always connects to host "db")
MYSQL_DATABASE=stn_atacs
MYSQL_USER=atacs
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-another-strong-password
# bound to 127.0.0.1 only
DB_PUBLISH_PORT=3307

# Sessions / security (keep the same values as on Vercel so existing data stays readable)
AUTH_SECRET=
THAID_CID_HASH_KEY=
AUTH_SESSION_DAYS=7
AUTH_IDLE_TIMEOUT_MINUTES=30

# ThaiD (update the callback URL at the ThaiD console to the new domain)
THAID_ENABLED=true
CLIENT_ID=
CLIENT_SECRET=
APIKEY=
CALLBACK=https://atacs.example.go.th/api/auth/thaiid/callback

# Google login (add the new redirect URI in Google Cloud Console)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://atacs.example.go.th/api/auth/google/callback

# Telegram alerts
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agent
# SEC-03: แนะนำให้ผูกคีย์กับหน่วยงาน ใช้รูปแบบ <facilityId>:<key> คั่นหลายรายการด้วย ,
#   ตัวอย่าง: ATACS_AGENT_INSTALL_KEY=12:KEY-FOR-FACILITY-12,34:KEY-FOR-FACILITY-34
# ค่าที่ไม่มี <facilityId>: จะเป็นคีย์กลางใช้ได้ทุกหน่วยงาน (ไม่แนะนำ)
ATACS_AGENT_INSTALL_KEY=
AGENT_OFFLINE_MINUTES=300
# Leave empty here. Set it on the OLD deployment (Vercel) to the new address so agents v1.1+ move by themselves.
AGENT_API_BASE_URL=
# SEC-06: โฮสต์ที่อนุญาตให้ประกาศเป็นที่อยู่ใหม่ของ agent (คั่นด้วย , รองรับ *.domain)
# ต้องเป็น https เท่านั้น และถ้าเว้นว่างไว้ ระบบจะไม่ประกาศที่อยู่ใหม่เลย
AGENT_API_BASE_ALLOWED_HOSTS=

# Scheduled jobs (replaces Vercel Cron); empty CRON_SECRET = disabled
CRON_SECRET=
CRON_INTERVAL_SECONDS=3600
# Daily Telegram summary time (HH:MM, Thai time)
DAILY_SUMMARY_TIME=08:00

# Nightly backup into ./backups (database dump + uploaded photos)
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
# 1 = also back up once right after the stack starts
BACKUP_ON_START=0
# Another folder on the host, e.g. a mounted NAS path
# BACKUP_HOST_DIR=/mnt/nas/atacs-backups
